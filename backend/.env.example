# URL of the stripe-api sidecar (see /stripe-api). Use http://127.0.0.1:8102 when backend runs on the host; Docker Compose overrides with http://stripe-api:8002 for backend/worker containers.
STRIPE_API_BASE=http://127.0.0.1:8102
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_DEFAULT_COMPANY_ID=
# Local dev: curl -H "X-Mock-Stripe-Secret: ..." must match. Leave empty in production.
MOCK_STRIPE_WEBHOOK_SECRET=dev-secret
# Administrator Stripe page: show “Send mock webhook” when true. false in production.
STRIPE_DEV_MOCK_UI_ENABLED=true
# When true, GET stripe-api /health after each synthetic webhook merge (Celery task result includes stripe_api_echo).
STRIPE_API_ECHO_AFTER_SYNTHETIC=false
DIFY_EXTERNAL_KB_API_KEY=
WISE_OAUTH_SCOPES_READ=profile balance transactions
WISE_OAUTH_SCOPES_WRITE=transfers
WISE_WRITE_ENABLED=false
WISE_API_BASE_SANDBOX=https://api.sandbox.transferwise.tech
WISE_API_BASE_PRODUCTION=https://api.transferwise.com
